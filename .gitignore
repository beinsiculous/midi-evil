# Rust and generated build output
/target/
**/*.rs.bk
*.tmp
*.new.prev
*.log

# Editors and local tooling
.idea/
.vscode/
.DS_Store
__pycache__/
*.pyc

# Local NanoStudio compatibility workspace (never published)
/compat/
/compat.toml
/compat.lock

# NanoStudio packages and instrument banks (compatibility fixtures stay local)
*.nsp
*.prj
Package.prj
Package.sng
*.bnk

# Engine-owned sidecars; MIDI Evil must not create these
*.mid.ron

# Generated audio and local project artifacts
*.wav
/song.rmp
/song.wav
/Minimal-copy.nsp
/Minimal.prj/

# Native .evil projects and public-domain .mid files are intentionally tracked.
# Cargo.lock is kept for reproducible application builds.

oracle
evil-porting

# Adversarial-review transient artifacts (see .claude/skills/adversarial-review/)
review/*
!review/.gitkeep

# Local-only Claude Code settings
.claude/settings.local.json

# Workbooks hold personal data. M's ruling (2026-10-19): every workbook is ignored in every
# repo of the working set, so personal data stays on the machines that hold it.
*.xlsx
